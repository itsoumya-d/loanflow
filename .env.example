APP_NAME=Loanflow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development: sqlite (default). Production: mysql.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=loanflow
# DB_USERNAME=loanflow
# DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@loanflow.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Loanflow domain
# ---------------------------------------------------------------------------
LOANFLOW_REFERENCE_PREFIX=LF
LOANFLOW_MIN_LOAN_AMOUNT_CENTS=100000
LOANFLOW_MAX_LOAN_AMOUNT_CENTS=200000000
LOANFLOW_MAX_ANNUAL_INCOME_CENTS=1000000000
LOANFLOW_IDEMPOTENCY_TTL_HOURS=72
LOANFLOW_METRICS_TOKEN=

# Keap / Infusionsoft CRM (OAuth 2.0 refresh token or client credentials)
KEAP_BASE_URL=https://api.infusionsoft.com
KEAP_TOKEN_URL=https://api.infusionsoft.com/token
KEAP_CLIENT_ID=
KEAP_CLIENT_SECRET=
KEAP_REFRESH_TOKEN=
KEAP_WEBHOOK_SECRET=
KEAP_WEBHOOK_SIGNATURE_HEADER=X-Keap-Signature
KEAP_TIMEOUT_SECONDS=10
KEAP_RETRY_ATTEMPTS=3
KEAP_RETRY_BASE_MS=200
KEAP_CUSTOM_FIELD_LOAN_REFERENCE=
KEAP_CUSTOM_FIELD_LOAN_AMOUNT=
KEAP_CUSTOM_FIELD_LOAN_STATUS=

# BigQuery streaming inserts
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=loanflow_analytics
BIGQUERY_TABLE=loan_events
# Paste JSON or base64-encoded JSON, or use a mounted file path.
BIGQUERY_SERVICE_ACCOUNT_JSON=
BIGQUERY_SERVICE_ACCOUNT_PATH=
BIGQUERY_TOKEN_URL=https://oauth2.googleapis.com/token
BIGQUERY_API_URL=https://bigquery.googleapis.com/bigquery/v2
BIGQUERY_TIMEOUT_SECONDS=15

# Google Tag Manager server-side tagging
GTM_SERVER_URL=
GTM_FORWARD_SECRET=
GTM_INGEST_SECRET=
GTM_TIMEOUT_SECONDS=10
